# Copiá este archivo a `.env` (nunca se versiona) y completá los valores.
# Las tres son públicas: viajan al navegador. La anon key es segura solo porque la tabla
# `leads` tiene Row Level Security con una única política de insert (supabase/migrations).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_CONTACT_EMAIL=
