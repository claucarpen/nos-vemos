---
// Ícono pixel de una medalla (spec 011). Los dibujos viven en src/lib/iconos-medallas.ts.
// Sin `medalla`, dibuja el genérico (el de Player 1), para contar medallas en el ranking.
import { capasDe } from '../../lib/iconos-medallas';
import type { MedallaId } from '../../lib/premios';

interface Props { medalla?: MedallaId; apagada?: boolean; size?: number }
const { medalla = 'primer_voto', apagada = false, size = 32 } = Astro.props;
---
<span class="medalla-icono" data-medalla={medalla} data-apagada={apagada ? '' : undefined} aria-hidden="true">
  <svg viewBox="0 0 10 10" shape-rendering="crispEdges" width={size} height={size}>
    {capasDe(medalla, apagada).map((c) => <path fill={c.color} d={c.d} />)}
  </svg>
</span>
