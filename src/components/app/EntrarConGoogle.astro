---
// Botón de login: POST a /auth/login, que redirige a Google vía Supabase y vuelve a `next`.
interface Props { next: string; texto?: string; aviso?: boolean }
const { next, texto = 'Entrar con Google', aviso = true } = Astro.props;
---
<form method="post" action="/auth/login" class="login">
  <input type="hidden" name="next" value={next} />
  <button type="submit" class="btn-start btn-block">{texto}</button>
</form>
{aviso && <p class="nota">Al entrar aceptás nuestra <a href="/privacidad">política de privacidad</a>.</p>}
