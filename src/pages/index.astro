---
import LeadForm from '../components/LeadForm.tsx';
import '../styles/global.css';

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nos Vemos — Press Start para la próxima juntada</title>
    <meta name="description" content="Nos Vemos junta la disponibilidad de tus amigos, insiste con los que no contestan y cierra la juntada sola." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/sprites/town_0.png" as="image" />
    <link rel="preload" href="/sprites/town_25.png" as="image" />
    <link rel="preload" href="/sprites/mascot.png" as="image" />
    <link rel="preload" href="/sprites/chest.png" as="image" />
    <link rel="preload" href="/sprites/potion.png" as="image" />
    <link rel="preload" href="/sprites/friend-p2.png" as="image" />
    <link rel="preload" href="/sprites/friend-p3.png" as="image" />
    <link rel="preload" href="/sprites/friend-p4.png" as="image" />
    <link rel="preload" href="/fonts/press-start-2p-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="hero-text">
        <div class="stars" aria-hidden="true">
          <i class="star" style="--sx:0;--sy:0px;--sd:3.1s;--sl:0s"></i>
          <i class="star m" style="--sx:3vw;--sy:38px;--sd:3.9s;--sl:-1.3s"></i>
          <i class="star" style="--sx:9vw;--sy:12px;--sd:2.7s;--sl:-2.1s"></i>
          <i class="star m" style="--sx:78vw;--sy:20px;--sd:4.3s;--sl:-0.6s"></i>
          <i class="star" style="--sx:90vw;--sy:48px;--sd:3.4s;--sl:-2.8s"></i>
          <i class="star m" style="--sx:94vw;--sy:10px;--sd:2.9s;--sl:-1.7s"></i>
          <i class="star" style="--sx:5vw;--sy:56px;--sd:3.7s;--sl:-0.2s"></i>
          <i class="star m" style="--sx:92vw;--sy:62px;--sd:4.1s;--sl:-3.3s"></i>
        </div>
          <div class="band band-1"><h1>NOS VEMOS</h1></div>
          <div class="band band-2">
            <p class="tagline">Press Start para la próxima juntada</p>
            <a class="cta-link" href="/nueva">Creá tu juntada</a>
          </div>
        </div>
        <div class="world" aria-hidden="true">
          <div class="ground ground-grass"></div>
          <div class="ground ground-dirt"></div>
          <img class="sp" src="/sprites/town_2.png" alt="" style="--x:-1.5;--y:1.5" />
          <img class="sp" src="/sprites/town_1.png" alt="" style="--x:1.5;--y:1.5" />
          <img class="sp w448" src="/sprites/town_2.png" alt="" style="--x:3.5;--y:1.5" />
          <img class="sp w448" src="/sprites/town_1.png" alt="" style="--x:-3.5;--y:1.5" />
          <img class="sp" src="/sprites/town_29.png" alt="" style="--x:-1.0;--y:1.55" />
          <img class="sp" src="/sprites/town_29.png" alt="" style="--x:1.0;--y:1.6" />
          <img class="sp w848" src="/sprites/town_2.png" alt="" style="--x:-5.5;--y:1.5" />
          <img class="sp w848" src="/sprites/town_1.png" alt="" style="--x:5.5;--y:1.5" />
          <img class="sp w912" src="/sprites/town_29.png" alt="" style="--x:-6;--y:1.55" />
          <img class="sp w912" src="/sprites/town_29.png" alt="" style="--x:6;--y:1.6" />
          <img class="sp w1360" src="/sprites/town_2.png" alt="" style="--x:9.5;--y:1.5" />
          <img class="sp tree w362" src="/sprites/town_4.png" alt="" style="--sd:0s;--x:-2.6;--y:0.9" />
          <img class="sp w362" src="/sprites/town_16.png" alt="" style="--x:-2.6;--y:1.9" />
          <img class="sp tree w362" src="/sprites/town_4.png" alt="" style="--sd:-1s;--x:2.6;--y:0.9" />
          <img class="sp w362" src="/sprites/town_16.png" alt="" style="--x:2.6;--y:1.9" />
          <img class="sp tree w733" src="/sprites/town_4.png" alt="" style="--sd:-2s;--x:-4.6;--y:0.9" />
          <img class="sp w733" src="/sprites/town_16.png" alt="" style="--x:-4.6;--y:1.9" />
          <img class="sp tree w733" src="/sprites/town_4.png" alt="" style="--sd:-0.5s;--x:4.6;--y:0.9" />
          <img class="sp w733" src="/sprites/town_16.png" alt="" style="--x:4.6;--y:1.9" />
          <img class="sp tree w1117" src="/sprites/town_4.png" alt="" style="--sd:-1.5s;--x:-7.6;--y:0.9" />
          <img class="sp w1117" src="/sprites/town_16.png" alt="" style="--x:-7.6;--y:1.9" />
          <img class="sp tree w1117" src="/sprites/town_4.png" alt="" style="--sd:-2.5s;--x:7.6;--y:0.9" />
          <img class="sp w1117" src="/sprites/town_16.png" alt="" style="--x:7.6;--y:1.9" />
          <img class="sp tree w1360" src="/sprites/town_4.png" alt="" style="--sd:-0.8s;--x:-9.2;--y:0.9" />
          <img class="sp w1360" src="/sprites/town_16.png" alt="" style="--x:-9.2;--y:1.9" />
          <img class="sp" src="/sprites/chest.png" alt="" style="--x:-1.7;--y:2.42" />
          <img class="sp" src="/sprites/potion.png" alt="" style="--x:1.2;--y:2.55" />
          <img class="sp mascot" src="/sprites/mascot.png" alt="" style="--x:-0.5;--y:2.45" />
          <div class="fr fr1"><img src="/sprites/friend-p2.png" alt="" /><span class="pn">P2</span></div>
          <div class="fr fr2"><img src="/sprites/friend-p3.png" alt="" /><span class="pn">P3</span></div>
          <div class="fr fr3"><img src="/sprites/friend-p4.png" alt="" /><span class="pn">P4</span></div>
          <span class="flash" aria-hidden="true"></span>
          <span class="clear" aria-hidden="true">LEVEL CLEAR</span>
          <i class="firefly" style="--x:-2.5;--y:1.85;--dd:5.1s;--dl:-1s;--gd:3.3s"></i>
          <i class="firefly" style="--x:-1.2;--y:2.05;--dd:6s;--dl:-3s;--gd:4.1s"></i>
          <i class="firefly" style="--x:0.2;--y:1.8;--dd:4.6s;--dl:-2s;--gd:3.7s"></i>
          <i class="firefly" style="--x:1.4;--y:2.1;--dd:5.6s;--dl:-4s;--gd:4.5s"></i>
          <i class="firefly" style="--x:2.5;--y:1.9;--dd:6.4s;--dl:-0.5s;--gd:3.9s"></i>
        </div>
      </section>

      <section id="problema" class="problem">
        <div class="wrap">
          <h2>La juntada que nunca se concreta</h2>
          <div class="panel">
            <ul>
              <li>El chat explota con mensajes y nadie cierra nada.</li>
              <li>«A ver si nos juntamos el jueves»… y llega el jueves sin fecha.</li>
              <li>Siempre están los mismos que nunca contestan, y vos terminás de organizador y de detective.</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="solucion">
        <div class="wrap">
          <h2>Nos Vemos lo resuelve por vos</h2>
          <div class="promises">
            <div class="panel">
              <div class="panel-head">
                <h3>Cierra solo</h3>
                <span class="tag tag-ok">Disponible</span>
              </div>
              <p>Cuando alcanza la cantidad de gente que definiste, la juntada queda confirmada. Sin vueltas. Y avisás al grupo por WhatsApp con un toque.</p>
            </div>
            <div class="panel">
              <div class="panel-head">
                <h3>Insiste por vos</h3>
                <span class="tag tag-soon">Próximamente</span>
              </div>
              <p>Recordatorios con fecha límite a los que no contestan, para que no tengas que perseguirlos.</p>
            </div>
            <div class="panel">
              <div class="panel-head">
                <h3>Se repite</h3>
                <span class="tag tag-soon">Próximamente</span>
              </div>
              <p>Armá la juntada una vez y se vuelve a organizar sola cada mes.</p>
            </div>
            <div class="panel">
              <div class="panel-head">
                <h3>Con premios</h3>
                <span class="tag tag-soon">Próximamente</span>
              </div>
              <p>Medallas, puntos y ranking para los que siempre aparecen. Hasta los que dudaban se suman.</p>
            </div>
          </div>
          <p class="promises-note">
            Lo que dice Próximamente llega en las próximas versiones. ¿Querés enterarte?{' '}
            <a href="#form-leads">Dejanos tu email</a>.
          </p>
        </div>
      </section>

      <section id="form-leads">
        <div class="wrap">
          <h2>¿Todavía no?</h2>
          <div class="panel">
            <p>Dejanos tu email y te avisamos de lo nuevo.</p>
            <LeadForm client:load />
            <p class="privacy">
              Usamos tu nombre y tu email solo para avisarte cuando Nos Vemos esté listo. También guardamos
              de qué link viniste, para saber qué canal funciona. No los compartimos ni los vendemos.{' '}
              {contactEmail
                ? <>Si querés que los borremos, escribinos a <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</>
                : null}{' '}
              Más detalles en nuestra <a href="/privacidad">política de privacidad</a>.
            </p>
          </div>
        </div>
      </section>
    </main>
    <script>
      // Pausa las animaciones del header mientras no se ve (clase leída por global.css).
      const hero = document.querySelector('.hero');
      if (hero && 'IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => hero.classList.toggle('is-offscreen', !e.isIntersecting)).observe(hero);
      }
    </script>
    <footer>Nos Vemos · hecho con pixeles y ganas de verte · <a href="/privacidad">Privacidad</a></footer>
  </body>
</html>
